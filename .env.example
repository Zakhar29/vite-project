# Скопируйте в .env и замените значения перед деплоем:
#   cp .env.example .env

# Публичный домен (без https://)
DOMAIN=melo.example.com

# Email для Let's Encrypt (Caddy)
ACME_EMAIL=admin@example.com

# JWT — одна и та же строка для всех сервисов (сгенерируйте: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=admin

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=change-me-mongo-password

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# Токены (опционально)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
